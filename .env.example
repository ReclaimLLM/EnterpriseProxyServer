# Required
BACKEND_SERVER=http://localhost:8080
ENTERPRISE_PROXY_SHARED_SECRET=change-me

# Optional — Supabase-backed org/team resolution
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — S3 access for this layer
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
S3_BUCKET_US=
S3_BUCKET_EU=

# Optional — tuning
GATEWAY_LOG_QUEUE_PATH=/var/lib/reclaimllm-enterprise-proxy/failed_logs.jsonl
BACKEND_TIMEOUT_SECONDS=15
LOG_FLUSH_INTERVAL_SECONDS=15
